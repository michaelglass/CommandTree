<Project>

  <!--
    Stamps the source revision (jj/git commit id) into the assembly informational version
    for dev builds, so a binary without CI/SourceLink metadata still reports the commit it
    was built from. The .NET SDK auto-appends $(SourceRevisionId) to
    AssemblyInformationalVersion as "+<rev>" when IncludeSourceRevisionInInformationalVersion
    is true (the default), so we only need to populate SourceRevisionId before that runs.

    Opt out entirely: -p:CommandTreeStampRevision=false
    Opt out of the dirty marker only: -p:CommandTreeStampDirty=false

    This target never fails the build and is silent on a failed probe: a missing jj/git
    or a non-repo just leaves the revision empty. Each probe sets two flags so a failed
    probe produces no diagnostics:
      * IgnoreExitCode="true" — a non-zero exit code (e.g. a git status probe in a
        directory that isn't a git repo) is treated as success, so Exec emits no
        MSB3073 warning.
      * IgnoreStandardErrorWarningFormat="true" — text the tool writes to stderr (e.g.
        jj's "There is no jj repo in ." when run outside a repo) is NOT promoted to an
        MSBuild error/warning, so it can't fail the build or add warning noise.
    ConsoleToMSBuild still captures stdout on the success path and leaves the property
    empty otherwise. SourceRevisionId is only set when a non-empty id was resolved. It
    also never clobbers an existing SourceRevisionId (CI / SourceLink already set it),
    and is skipped during design-time builds so IDEs don't spawn jj/git on every
    background evaluation.
  -->
  <Target Name="CommandTreeStampSourceRevision"
          BeforeTargets="AddSourceRevisionToInformationalVersion;CoreCompile"
          Condition="'$(SourceRevisionId)' == '' And '$(CommandTreeStampRevision)' != 'false' And '$(DesignTimeBuild)' != 'true'">

    <!-- Resolve the commit id: prefer jj, fall back to git. Trim jj output once and reuse it. -->
    <Exec Command="jj log --no-graph -r @ -T commit_id"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CommandTreeJjRevision" />
    </Exec>

    <!-- ConsoleToMSBuild merges the probe's stdout AND stderr, so on failure the captured
         text is the tool's error message (e.g. jj's "Error: There is no jj repo in ."),
         not a commit id. Accept the value only when it's a bare hex id; anything else
         (an error message, with spaces/punctuation) is discarded so the revision stays
         empty — honoring the "empty on failure" intent and keeping junk out of the
         stamped AssemblyInformationalVersion. -->
    <PropertyGroup>
      <_CommandTreeJjRevision>$(_CommandTreeJjRevision.Trim())</_CommandTreeJjRevision>
      <_CommandTreeJjRevision Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_CommandTreeJjRevision)', '^[0-9a-fA-F]+$'))"></_CommandTreeJjRevision>
      <_CommandTreeRevision>$(_CommandTreeJjRevision)</_CommandTreeRevision>
    </PropertyGroup>

    <Exec Command="git rev-parse HEAD"
          Condition="'$(_CommandTreeRevision)' == ''"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CommandTreeGitRevision" />
    </Exec>

    <PropertyGroup Condition="'$(_CommandTreeRevision)' == ''">
      <_CommandTreeGitRevision>$(_CommandTreeGitRevision.Trim())</_CommandTreeGitRevision>
      <_CommandTreeGitRevision Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_CommandTreeGitRevision)', '^[0-9a-fA-F]+$'))"></_CommandTreeGitRevision>
      <_CommandTreeRevision>$(_CommandTreeGitRevision)</_CommandTreeRevision>
    </PropertyGroup>

    <!-- Probe for a dirty working copy (optional ".dirty" marker), using whichever VCS
         supplied the revision. Both probes write the same _CommandTreeDirty property, so
         only the one that runs sets it. -->
    <PropertyGroup>
      <_CommandTreeCheckDirty Condition="'$(_CommandTreeRevision)' != '' And '$(CommandTreeStampDirty)' != 'false'">true</_CommandTreeCheckDirty>
    </PropertyGroup>

    <Exec Command="jj diff"
          Condition="'$(_CommandTreeCheckDirty)' == 'true' And '$(_CommandTreeJjRevision)' != ''"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CommandTreeDirty" />
    </Exec>

    <Exec Command="git status --porcelain"
          Condition="'$(_CommandTreeCheckDirty)' == 'true' And '$(_CommandTreeJjRevision)' == ''"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CommandTreeDirty" />
    </Exec>

    <PropertyGroup Condition="'$(_CommandTreeRevision)' != '' And '$(_CommandTreeDirty.Trim())' != ''">
      <_CommandTreeRevision>$(_CommandTreeRevision).dirty</_CommandTreeRevision>
    </PropertyGroup>

    <!-- Only set SourceRevisionId when a non-empty id was resolved. -->
    <PropertyGroup Condition="'$(_CommandTreeRevision)' != ''">
      <SourceRevisionId>$(_CommandTreeRevision)</SourceRevisionId>
    </PropertyGroup>

  </Target>

</Project>
