<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>CommandTree</PackageId>
    <Version>0.8.0</Version>
    <Authors>Michael Glass</Authors>
    <Description>Type-safe CLI command parsing with discriminated unions and reflection-based tree generation</Description>
    <PackageTags>fsharp;cli;command;parsing;discriminated-union;reflection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/michaelglass/CommandTree</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <WarnOn>3390;1104;0020;0044;0025;3391;0067;0021;1182</WarnOn>
    <!-- NETSDK1188: harmless locale warnings from FSharp.Core -->
    <!-- FS0052: string indexer copy warning - harmless -->
    <NoWarn>$(NoWarn);NETSDK1188;FS0052</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- Auto-importing build target that stamps the source revision into the informational
         version. build/ covers older direct refs; buildTransitive/ covers transitive +
         modern direct refs. Not compiled (it's MSBuild, not F#). -->
    <None Include="build/CommandTree.targets"
          Pack="true"
          PackagePath="build/CommandTree.targets"
          Visible="false" />
    <None Include="build/CommandTree.targets"
          Pack="true"
          PackagePath="buildTransitive/CommandTree.targets"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CommandTree.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Attributes.fs" />
    <Compile Include="Tree.fs" />
    <Compile Include="SpecError.fs" />
    <Compile Include="Reflection.fs" />
    <Compile Include="UI.fs" />
    <Compile Include="Process.fs" />
    <Compile Include="Fish.fs" />
  </ItemGroup>
</Project>
