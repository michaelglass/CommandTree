<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- NETSDK1188: harmless locale warnings from Microsoft.Testing.Platform.
         NU1608: references CommandTree.Analyzers, which pulls FSharp.Analyzers.SDK 0.37.2
         (pinned to FCS 43.12.201 / FSharp.Core 10.1.201) while this repo resolves a 43.* FCS.
         Same documented skew the analyzer project suppresses; consuming projects must
         suppress it too (cf. fsharp-analyzers, FSharpLintAnalyzerShim). -->
    <NoWarn>$(NoWarn);NU1605;NU1608;MSB3277;NETSDK1188</NoWarn>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CommandTreeAnalyzerTests.fs" />
  </ItemGroup>

  <!-- xUnit runner configuration -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CommandTree.Analyzers/CommandTree.Analyzers.fsproj" />
    <ProjectReference Include="../../src/CommandTree/CommandTree.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FSharp.Analyzers.SDK.Testing 0.37.2 hard-pins FCS = 43.12.201, while the analyzer
         project (and this repo's solution) floats FCS to 43.* (resolving to 43.12.204). At
         RUNTIME the analyzer DLL's IL binds to the exact 43.12.x it compiled against, so the
         test output must carry that same FCS, not the harness's pin. Reference FCS directly
         at 43.12.204 so it wins the conflict (NU1107's prescribed resolution) AND matches the
         analyzer's compiled FCS — the testing harness's checker is API-compatible across this
         43.12.201→43.12.204 patch range for the surface it uses. -->
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.204" />
    <PackageReference Include="FSharp.Analyzers.SDK.Testing" Version="0.37.2" />
    <PackageReference Include="Unquote" Version="7.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.8.0" />
  </ItemGroup>

</Project>
